{{- $dotfiles := .chezmoi.sourceDir | dir -}}
{{- $target := joinPath .chezmoi.homeDir ".claude" "settings.json" -}}
{{- $settings := dict -}}
{{- if stat $target -}}
{{-   $settings = include $target | fromJson -}}
{{- end -}}
{{- $hooks := dict
      "WorktreeCreate" (list (dict "hooks" (list (dict "type" "command" "command" (printf "%s/bin/claude-ws-create" $dotfiles)))))
      "WorktreeRemove" (list (dict "hooks" (list (dict "type" "command" "command" (printf "%s/bin/claude-ws-remove" $dotfiles)))))
-}}
{{- $settings = mergeOverwrite $settings (dict "hooks" $hooks) -}}
{{ $settings | toPrettyJson }}
