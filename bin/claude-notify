#!/bin/bash

# Sends a webhook when Claude has been waiting for 30 seconds for a response.
#
# Add to ~/.claude/settings.json:
# "hooks": {
#   "Stop": [
#     {
#       "hooks": [
#         {
#           "type": "command",
#           "command": "$HOME/.local/share/chezmoi/bin/claude-notify <webhook url>",
#           "async": true,
#           "timeout": 300
#         }
#       ]
#     }
#   ],
#   "Notification": [
#     {
#       "matcher": "idle_prompt",
#       "hooks": [
#         {
#           "type": "command",
#           "command": "$HOME/.local/share/chezmoi/bin/claude-notify <webhook url>",
#           "async": true,
#           "timeout": 300
#         }
#       ]
#     },
#     {
#       "matcher": "permission_prompt",
#       "hooks": [
#         {
#           "type": "command",
#           "command": "$HOME/.local/share/chezmoi/bin/claude-notify <webhook url>",
#           "async": true,
#           "timeout": 300
#         }
#       ]
#     }
#   ]
# }

# Read hook input from stdin
INPUT=$(cat)

# Extract information
TRANSCRIPT_PATH=$(echo "$INPUT" | jq -r '.transcript_path')
NOTIFICATION_TYPE=$(echo "$INPUT" | jq -r '.notification_type // "stop"')
HOOK_EVENT=$(echo "$INPUT" | jq -r '.hook_event_name')
WEBHOOK=$1

SESSION_ID=$(echo "$INPUT" | jq -r '.session_id')
PROJECT=$(echo "$INPUT" | jq -r '.cwd' | xargs basename)

send_webhook() {
  # Build the payload with jq so quotes in the message can't break the JSON.
  PAYLOAD=$(jq -n \
    --arg session_id "$SESSION_ID" \
    --arg project "$PROJECT" \
    --arg notification_type "$NOTIFICATION_TYPE" \
    --arg hook_event "$HOOK_EVENT" \
    --arg message "$1" \
    '$ARGS.named')
  curl -s -X POST "$WEBHOOK" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD"
}

# Modification time in seconds since the epoch; GNU stat first, then BSD stat.
mtime() {
  stat -c "%Y" "$1" 2>/dev/null || stat -f "%m" "$1" 2>/dev/null
}

if [[ "$HOOK_EVENT" == "PostToolUse" || "$HOOK_EVENT" == "PostToolUseFailure" || "$HOOK_EVENT" == "SessionEnd" ]]; then
  send_webhook "clear_notification"
else
  # Record when we started
  START_TIME=$(date +%s)

  # Wait to see if I respond locally
  # Use different delays based on event type
  if [ "$HOOK_EVENT" = "Stop" ]; then
    SLEEP_DURATION=30
  else
    SLEEP_DURATION=25
  fi

  sleep $SLEEP_DURATION

  # Check if transcript was modified since we started
  LAST_MODIFIED=$(mtime "$TRANSCRIPT_PATH")

  if [ "${LAST_MODIFIED:-0}" -le "$START_TIME" ]; then
    # No new activity - send notification
    MESSAGE=$(echo "$INPUT" | jq -r '.message // "Claude finished responding"')
    send_webhook "$MESSAGE"
  fi
fi
