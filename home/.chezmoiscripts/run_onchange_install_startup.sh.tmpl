#! /bin/bash

. "{{ .chezmoi.sourceDir | dir }}/shared/functions.sh"

INIT_MARKER="# dotfiles"

strip_file() {
  strip "{{ .chezmoi.homeDir }}/.$1" $2
}

add_init() {
  append "{{ .chezmoi.homeDir }}/.$1" \
    "[ -r \"{{ .chezmoi.homeDir }}/.config/dotfiles/$1.sh\" ] && . \"{{ .chezmoi.homeDir }}/.config/dotfiles/$1.sh\" $INIT_MARKER"
}

for target in "bashrc" "bash_profile"; do
  strip_file $target "$INIT_MARKER"
  strip_file $target ".cargo\\/env"
done

add_init "bashrc"
add_init "bash_profile"
