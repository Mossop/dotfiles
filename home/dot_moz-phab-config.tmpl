{{- if and (hasKey . "mozilla") .mozilla -}}
{{- /* Preserve moz-phab's own record of when it last checked for updates. */ -}}
{{- $lastCheck := "" -}}
{{- $existing := joinPath .chezmoi.homeDir ".moz-phab-config" -}}
{{- if stat $existing -}}
{{-   $lastCheck = include $existing | fromIni | dig "updater" "self_last_check" "" -}}
{{- end -}}
[ui]
no_ansi = False
hyperlinks = True
open_browser = True

[vcs]
safe_mode = False

[git]
remote = central
command_path = 

[hg]
command_path = hg

[submit]
auto_submit = True
always_blocking = True
warn_untracked = True
ai_review = False
review_queue_reminder_frequency = 0
review_queue_reminder_include_groups = True

[patch]
apply_to = here
create_bookmark = False
create_topic = False
create_branch = False
always_full_stack = False
branch_name_template = phab-D{rev_id}
create_commit = True
no_commit = True

[updater]
{{- if $lastCheck }}
self_last_check = {{ $lastCheck }}
{{- end }}
self_auto_update = False
get_pre_releases = False
arc_last_check = 0

[error_reporting]
report_to_sentry = True

[telemetry]
enabled = True
{{- end }}