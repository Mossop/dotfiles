[ui]
no_ansi = False
hyperlinks = True
open_browser = True

[vcs]
safe_mode = False

[git]
remote = central
command_path = 

[hg]
command_path = hg

[submit]
auto_submit = True
always_blocking = True
warn_untracked = True
ai_review = False
review_queue_reminder_frequency = 0
review_queue_reminder_include_groups = True

[patch]
apply_to = here
create_bookmark = False
create_topic = False
create_branch = False
always_full_stack = False
branch_name_template = phab-D{rev_id}
create_commit = True
no_commit = True

[updater]
{%- set path = [env.HOME, ".moz-phab-config"] | join_path %}
{%- if path is file %}
{{ read_file(path=path) | regex_replace(pattern='(?s)^.*(self_last_check = \\d+).*$', rep="$1") }}
{%- endif %}
self_auto_update = False
get_pre_releases = False
arc_last_check = 0

[error_reporting]
report_to_sentry = True

[telemetry]
enabled = True
